<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://android.com">

    <!-- Permission to access the internet for dictionary search -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TopacAdemy_android"
        tools:targetApi="31">

        <!-- 1. DictionaryActivity is the main entry point -->
        <activity
            android:name=".ui.DictionaryActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. NEW: FavoritesActivity registration (Critical to avoid crash) -->
        <activity
            android:name=".ui.FavoritesActivity"
            android:exported="false"
            android:label="Favorite Words"
            android:parentActivityName=".ui.DictionaryActivity">
            <!-- This adds the "back" button support in the toolbar -->
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.DictionaryActivity" />
        </activity>

        <!-- 3. MainActivity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- 4. DetailActivity (Cars) -->
        <activity
            android:name=".ui.DetailActivity"
            android:exported="false" />

    </application>
</manifest>
