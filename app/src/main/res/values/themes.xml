<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TopacAdemy_android" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <!-- Базовый стиль кнопки -->
    <style name="CalcBtn" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">28sp</item>
        <item name="cornerRadius">40dp</item>
    </style>

    <!-- Стиль для цифр (темно-серые) -->
    <style name="CalcBtn.Number">
        <item name="backgroundTint">#333333</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Стиль для операций (оранжевые) -->
    <style name="CalcBtn.Operator">
        <item name="backgroundTint">#FF9500</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Стиль для функций (светло-серые) -->
    <style name="CalcBtn.Function">
        <item name="backgroundTint">#A5A5A5</item>
        <item name="android:textColor">#000000</item>
    </style>


    <style name="Theme.TopacAdemy_android" parent="Base.Theme.TopacAdemy_android" />
</resources>